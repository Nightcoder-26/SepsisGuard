# SepsisGuard v3.0 Environment Configuration
# Copy this file to .env and configure secrets prior to deployment

# Secret key for Flask session security (REQUIRED in production)
FLASK_SECRET_KEY=change_me_to_a_secure_random_64_char_hex_string

# API key for REST endpoints and Socket.IO authentication (REQUIRED)
API_KEY=sepsisguard_api_key_3f7b9a1c5d8e2f4a6c0b8d1e3f5a7c9b

# Google Gemini API key for clinical copilot narratives (OPTIONAL - fallback active if omitted)
GEMINI_API_KEY=

# CORS Allowed Origins (Comma-separated list, NO wildcard '*')
FRONTEND_ORIGIN=http://localhost:5000,http://127.0.0.1:5000

# Rate limit for POST /predict
PREDICT_RATE_LIMIT=60 per minute
